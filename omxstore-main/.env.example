# OMEX Store — required environment variables.
# In Vercel: Project → Settings → Environment Variables (Production + Preview),
# then REDEPLOY (VITE_* values are inlined at BUILD time).
# Get values from Supabase → Project Settings → API.

# Client bundle (inlined at build). MUST be a full https URL.
VITE_SUPABASE_URL=https://YOUR-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key
VITE_SUPABASE_PROJECT_ID=your-project-ref

# Server (SSR / server functions). Mirror the values above.
SUPABASE_URL=https://YOUR-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key
SUPABASE_PROJECT_ID=your-project-ref

# Server-only (never VITE_-prefixed). Used by admin/service operations.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: WhatsApp number for order CTAs (digits only)
VITE_WHATSAPP_NUMBER=
